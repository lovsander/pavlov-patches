<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PAPPA на C#: без NuGet-пакетов вообще (ни JSON, ни тест-фреймворка).
    Собирается офлайн: dotnet build -c Release.

    InvariantGlobalization -> '.' в числах при любой локали машины;
    UseAppHost -> рядом с pappa.dll получаем pappa.exe, который вызывают
    сборочный скрипт и verify_all.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pappa</RootNamespace>
    <AssemblyName>pappa</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0168;CS0219</NoWarn>
  </PropertyGroup>

</Project>
