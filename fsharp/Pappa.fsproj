<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PAPPA на F#: без NuGet-пакетов вообще (ни JSON, ни тест-фреймворка).
    Собирается офлайн: dotnet build -c Release.

    Порядок <Compile> — это порядок КОМПИЛЯЦИИ: файл в F# видит только то, что
    объявлено выше, циклических ссылок между файлами не бывает. Поэтому список
    идёт «снизу вверх»: утилиты -> статистика -> анализ -> модель -> ввод/вывод -> CLI.

    InvariantGlobalization -> '.' в числах при любой локали машины;
    UseAppHost -> рядом с pappa.dll получаем pappa.exe (Windows).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pappa</RootNamespace>
    <AssemblyName>pappa</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Fmt.fs" />
    <Compile Include="src/Json.fs" />
    <Compile Include="src/Linalg.fs" />
    <Compile Include="src/Signal.fs" />
    <Compile Include="src/Analysis.fs" />
    <Compile Include="src/Model.fs" />
    <Compile Include="src/Io.fs" />
    <Compile Include="src/Cli.fs" />
  </ItemGroup>

</Project>
