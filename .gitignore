# ==============================================================================
# Build artifacts (C / C++ / CMake)
# ==============================================================================
build/
out/
cmake-build-*/
*.exe
*.obj
*.o
*.lo
*.a
*.lib
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.idb
*.exp
*.tlog
vc140.pdb

# ==============================================================================
# IDE / editors
# ==============================================================================
.vs/
.idea/
*.user
*.suo
# Machine-specific VS Code settings (absolute paths) are ignored.
# Shared/team config (tasks, launch, extensions, c_cpp_properties) is tracked.
.vscode/settings.json

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/

# ==============================================================================
# Generated data / reports / serialized models
# ==============================================================================
synthetic_data*.csv
smoothed_geometry_output.csv
model_*.txt
report_*.txt
*.npz

# ==============================================================================
# Generated images (plot snapshots from scripts).
# Curated presentation assets live under docs/assets/ and ARE tracked.
# ==============================================================================
*.png
*.svg
!docs/assets/**/*.png
!docs/assets/**/*.svg

# Local session handoff notes (not part of the public repo)
CONTEXT.md

# ==============================================================================
# Описания образцов (samples/ в корне): манифест + по файлу модели на сечение.
# Генерируются пайплайном (Python и порты), конформанс-векторы для тестов
# лежат отдельно и ЗАКОММИЧЕНЫ в spec/conformance/.
# ==============================================================================
/samples/
# Каталоги сборки CMake по пресетам (build-cmake/<preset>)
build-cmake/

# ==============================================================================
# embedded/: сборки прошивки и хост-пробы (не коммитятся; сами исходники — да)
# ==============================================================================
/embedded/uno/build/
/embedded/build_host/

# C-����: ��������� ���������� ��� �������� �������� �� Python
/c/pappa.dll
/c/pappa.so


# ==============================================================================
# java/: compiled classes (not committed; sources are)
# ==============================================================================
/java/out/
*.class

# kotlin/: compiled classes (not committed; sources are)
/kotlin/out/

# rust/: compiled binaries (not committed; sources are)
/rust/target/

# pascal/: compiled binaries and units (not committed; sources are)
/pascal/bin/
/pascal/lib/

# swift/: SwiftPM build directory (not committed; sources are)
/swift/.build/
/swift/dbg*

# ==============================================================================
# r/: R workspace leftovers (sources are committed; nothing here is needed)
# ==============================================================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf
# ==============================================================================
# csharp/: сборка .NET (bin/obj не коммитятся; исходники — да)
# ==============================================================================
/csharp/bin/
/csharp/obj/

# ==============================================================================
# octave/: рабочие файлы Octave (исходники — да). Компиляции нет, поэтому
# игнорировать нужно только то, что Octave оставляет после падения/паузы.
# ==============================================================================
/octave/octave-workspace
/octave/*.mat

